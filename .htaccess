<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redireciona a raiz para a pasta public de forma transparente
    RewriteRule ^$ public/ [L]

    # Se o arquivo ou pasta solicitada não existirem na raiz...
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Envia silenciosamente para o index da pasta public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
